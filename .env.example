APP_NAME="DevOps Practice Target"
APP_ENV=local
# Leave blank, then run: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Port used by `php artisan serve` (see README "Run it locally").
APP_PORT=8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database: SQLite by default (zero setup) ---
# For the Compose mission (M15) switch these to MySQL.
DB_CONNECTION=sqlite
# DB_DATABASE must be an ABSOLUTE path, or just leave default sqlite handling.
# DB_DATABASE=/var/www/html/database/database.sqlite

# --- Example MySQL config for the Compose / Cloud missions ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=laravel
# DB_PASSWORD=secret

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
